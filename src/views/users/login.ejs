<% layout('layout/boilerplate') %>

<style>
  .login-page {
    min-height: 75vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 16px;
    background:
      radial-gradient(circle at 10% 10%, rgba(25, 135, 84, .09), transparent 35%),
      radial-gradient(circle at 90% 90%, rgba(13, 110, 253, .07), transparent 35%);
  }

  .login-card {
    width: 100%;
    max-width: 440px;
    padding: 38px;
    border: 1px solid rgba(255, 255, 255, .8);
    border-radius: 24px;
    background: rgba(255, 255, 255, .96);
    box-shadow: 0 20px 60px rgba(24, 39, 30, .10);
    animation: loginFadeIn .6s ease both;
  }

  @keyframes loginFadeIn {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .login-brand-icon {
    width: 62px;
    height: 62px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    border-radius: 20px;
    color: #fff;
    background: linear-gradient(135deg, #198754, #20a875);
    box-shadow: 0 8px 20px rgba(25, 135, 84, .22);
    font-size: 28px;
  }

  .login-title {
    color: #172b21;
    font-size: 2rem;
    font-weight: 750;
    letter-spacing: -1px;
  }

  .login-subtitle {
    color: #78847d;
    font-size: .95rem;
    line-height: 1.6;
  }

  .login-label {
    display: block;
    margin-bottom: 8px;
    color: #293b31;
    font-size: .9rem;
    font-weight: 650;
  }

  .login-input-wrap {
    position: relative;
  }

  .login-input-wrap > i {
    position: absolute;
    top: 50%;
    left: 15px;
    transform: translateY(-50%);
    color: #849188;
    font-size: 17px;
    pointer-events: none;
  }

  .login-input {
    min-height: 52px;
    padding: 12px 14px 12px 44px;
    border: 1px solid #e0e8e2;
    border-radius: 12px;
    background: #fbfcfb;
    color: #24372c;
    transition: border-color .2s, box-shadow .2s, background .2s;
  }

  .login-input::placeholder {
    color: #a2aca5;
  }

  .login-input:focus {
    border-color: #198754;
    background: #fff;
    box-shadow: 0 0 0 4px rgba(25, 135, 84, .10);
  }

  .login-btn {
    min-height: 52px;
    border: 0;
    border-radius: 12px;
    background: linear-gradient(135deg, #198754, #20a875);
    color: #fff;
    font-weight: 700;
    box-shadow: 0 8px 18px rgba(25, 135, 84, .18);
    transition: transform .2s, box-shadow .2s;
  }

  .login-btn:hover {
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 12px 24px rgba(25, 135, 84, .25);
  }

  .login-alert {
    border: 0;
    border-radius: 12px;
    font-size: .9rem;
  }

  .login-divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 24px 0 18px;
    color: #a0aaa3;
    font-size: .8rem;
  }

  .login-divider::before,
  .login-divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background: #e9eeea;
  }

  .login-footer {
    margin: 0;
    color: #78847d;
    font-size: .92rem;
    text-align: center;
  }

  .login-footer a {
    color: #198754;
    font-weight: 700;
    text-decoration: none;
  }

  .login-footer a:hover {
    text-decoration: underline;
  }

  @media (max-width: 480px) {
    .login-page {
      min-height: auto;
      padding: 28px 12px;
    }

    .login-card {
      padding: 28px 22px;
      border-radius: 20px;
    }

    .login-title {
      font-size: 1.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .login-card {
      animation: none;
    }

    .login-input,
    .login-btn {
      transition: none;
    }
  }
</style>

<div class="login-page">
  <div class="login-card">
    <div class="login-brand-icon">
      <i class="bi bi-house-heart-fill" aria-hidden="true"></i>
    </div>

    <div class="text-center mb-4">
      <h1 class="login-title mb-2">Welcome back!</h1>
      <p class="login-subtitle mb-0">
        Your next getaway is just a login away.
      </p>
    </div>

    <% if (error && error.length) { %>
      <div class="alert alert-danger login-alert alert-dismissible fade show" role="alert">
        <% error.forEach((message) => { %>
          <div><%= message %></div>
        <% }) %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <% if (success && success.length) { %>
      <div class="alert alert-success login-alert alert-dismissible fade show" role="alert">
        <% success.forEach((message) => { %>
          <div><%= message %></div>
        <% }) %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <form action="/login" method="POST">
      <div class="mb-3">
        <label for="username" class="login-label">Username</label>
        <div class="login-input-wrap">
          <i class="bi bi-person" aria-hidden="true"></i>
          <input
            type="text"
            class="form-control login-input"
            id="username"
            name="username"
            autocomplete="username"
            required
            placeholder="Enter your username"
          >
        </div>
      </div>

      <div class="mb-4">
        <label for="password" class="login-label">Password</label>
        <div class="login-input-wrap">
          <i class="bi bi-lock" aria-hidden="true"></i>
          <input
            type="password"
            class="form-control login-input"
            id="password"
            name="password"
            autocomplete="current-password"
            required
            placeholder="Enter your password"
          >
        </div>
      </div>

      <button type="submit" class="btn login-btn w-100">
        Login to StayVista
        <i class="bi bi-arrow-right ms-2" aria-hidden="true"></i>
      </button>
    </form>

    <div class="login-divider">NEW TO STAYVISTA?</div>

    <p class="login-footer">
      Don't have an account?
      <a href="/register">Create your account</a>
    </p>
  </div>
</div>