
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title><%= typeof title !== "undefined" && title ? `${title} | StayVista` : "StayVista | Find Your Stay" %></title>

  <meta name="theme-color" content="#ffffff" />
  <meta name="description" content="Discover unique stays and find your next getaway with StayVista." />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
  />

  <link rel="stylesheet" href="/css/style.css" />
</head>

<body class="d-flex flex-column min-vh-100">

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-light bg-white sticky-top stayvista-navbar">
    <div class="container py-2">

      <a class="navbar-brand stayvista-brand" href="/">
        <i class="bi bi-house-heart-fill me-2"></i>StayVista
      </a>

      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNav">

        <ul class="navbar-nav mx-auto my-3 my-lg-0">
          <li class="nav-item">
            <a class="nav-link" href="/">
              <i class="bi bi-house-door me-1"></i>Home
            </a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/listings">
              <i class="bi bi-buildings me-1"></i>All Listings
            </a>
          </li>
        </ul>

        <div class="navbar-actions d-flex flex-column flex-lg-row align-items-stretch align-items-lg-center gap-2">

          <a href="/listings/addListing" class="btn btn-stayvista">
            <i class="bi bi-plus-lg me-1"></i>
            Add Listing
          </a>

          <% if (currentUser) { %>

            <div class="user-greeting">
              <i class="bi bi-person-circle me-1"></i>
              Hi, <%= currentUser.username %>
            </div>

            <a href="/logout" class="btn btn-outline-dark rounded-pill px-3">
              <i class="bi bi-box-arrow-right me-1"></i>
              Logout
            </a>

          <% } else { %>

            <a href="/login" class="btn btn-outline-dark rounded-pill px-3">
              Login
            </a>

            <a href="/register" class="btn btn-dark rounded-pill px-3">
              <i class="bi bi-person-plus me-1"></i>
              Sign Up
            </a>

          <% } %>

        </div>
      </div>
    </div>
  </nav>

  <!-- Flash Messages -->
  <div class="container flash-container">
    <% if (typeof success !== "undefined" && success.length) { %>
      <% success.forEach(message => { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <i class="bi bi-check-circle-fill me-2"></i>
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% }) %>
    <% } %>

    <% if (typeof error !== "undefined" && error.length) { %>
      <% error.forEach(message => { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <i class="bi bi-exclamation-circle-fill me-2"></i>
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% }) %>
    <% } %>
  </div>

  <!-- Main Content -->
  <main class="flex-grow-1 py-4">
    <%- body %>
  </main>

  <!-- Footer -->
  <footer class="stayvista-footer mt-auto">
    <div class="container py-5">

      <div class="row g-4">

        <div class="col-lg-4 col-md-6">
          <a href="/" class="footer-brand">
            <i class="bi bi-house-heart-fill me-2"></i>StayVista
          </a>

          <p class="footer-description mt-3">
            Find your place in the world. Discover beautiful stays
            and make every journey memorable.
          </p>
        </div>

        <div class="col-lg-2 col-md-6 col-6">
          <h6 class="footer-heading">Explore</h6>
          <ul class="footer-links">
            <li><a href="/">Home</a></li>
            <li><a href="/listings">All Listings</a></li>
            <li><a href="/listings/addListing">Add a Listing</a></li>
          </ul>
        </div>

        <div class="col-lg-3 col-md-6 col-6">
          <h6 class="footer-heading">Account</h6>
          <ul class="footer-links">
            <% if (currentUser) { %>
              <li><a href="/logout">Logout</a></li>
            <% } else { %>
              <li><a href="/login">Login</a></li>
              <li><a href="/register">Create Account</a></li>
            <% } %>
          </ul>
        </div>

        <div class="col-lg-3 col-md-6">
          <h6 class="footer-heading">Stay Connected</h6>
          <p class="footer-description">
            Your next adventure starts with StayVista.
          </p>

          <div class="social-icons">
            <a href="https://www.instagram.com/" aria-label="Instagram">
              <i class="bi bi-instagram"></i>
            </a>
            <a href="https://www.facebook.com/" aria-label="Facebook">
              <i class="bi bi-facebook"></i>
            </a>
            <a href="https://www.linkedin.com/" aria-label="LinkedIn">
              <i class="bi bi-linkedin"></i>
            </a>
          </div>
        </div>

      </div>

      <div class="footer-bottom mt-5 pt-4">
        <p class="mb-0">
          &copy; <%= new Date().getFullYear() %> StayVista.
          All rights reserved.
        </p>

        <p class="mb-0">Made for memorable stays <i class="bi bi-heart-fill"></i></p>
      </div>

    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
